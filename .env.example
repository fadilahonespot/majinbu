# AI Configuration
# Get your API key from your AI provider (OpenAI, Gemini, Anthropic, etc.)
AI_API_KEY=your_ai_api_key

# Model ID to use (e.g., gpt-4o-mini, gemini-2.0-flash, claude-3-5-haiku)
AI_MODEL=gemini-2.0-flash

# Base URL (optional - only needed for custom/self-hosted AI)
# AI_BASE_URL=https://api.openai.com/v1
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_BASE_URL=https://api.anthropic.com

# Debug (optional)
# AI_LOG_RAW_RESPONSE=true

# PixVerse (uses CLI auth — `pixverse auth login`)

# Pexels
PEXELS_API_KEY=your_pexels_api_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/majinbu

# Storage
VIDEO_STORAGE_PATH=./storage/videos

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
